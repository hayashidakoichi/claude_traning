<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="diagram" name="図"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1344" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Claude Code の基本ワークフロー — 毎回の仕事はこの流れで進む（8 ステップ）" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#2F3437;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="34" width="1100" height="40" as="geometry" /></mxCell><mxCell id="h1" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 1&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#64707D;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="140" height="80" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b style=&quot;font-size:16px;color:#64707D;&quot;&gt;作業フォルダを作成&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;案件ごとに専用フォルダを 1 つ&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;C:\work\yamada-seiko&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;新しい案件 = 新しいフォルダ&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="980" height="80" as="geometry" /></mxCell><mxCell id="h2" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 2&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#64707D;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="140" height="80" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b style=&quot;font-size:16px;color:#64707D;&quot;&gt;資材を集める&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;読ませたい資料をフォルダへ&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;hearing-memo.md&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;data.csv&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;これが INPUT になる&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="272" width="980" height="80" as="geometry" /></mxCell><mxCell id="h3" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 3&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#64707D;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="394" width="140" height="80" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b style=&quot;font-size:16px;color:#64707D;&quot;&gt;PLAN.md（指示書）を作成&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;やりたいことを文章で書き出す&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;PLAN.md&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;目的 / INPUT / OUTPUT / 条件&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="394" width="980" height="80" as="geometry" /></mxCell><mxCell id="h4" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 4&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#64707D;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="516" width="140" height="80" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b style=&quot;font-size:16px;color:#64707D;&quot;&gt;claude を起動&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;その作業フォルダから起動する&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;claude&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;= ここが作業範囲（安全の仕組み）&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#64707D;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="516" width="980" height="80" as="geometry" /></mxCell><mxCell id="h5" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 5&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#BC5B38;strokeColor=#BC5B38;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="638" width="140" height="80" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b style=&quot;font-size:16px;color:#BC5B38;&quot;&gt;PLAN.md に従って実行&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;指示はこの 1 行でよい&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;PLAN.md に従って実行して&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;詳細は指示書に任せる&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#FAEDE7;strokeColor=#BC5B38;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="638" width="980" height="80" as="geometry" /></mxCell><mxCell id="h6" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 6&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#5F7D63;strokeColor=#5F7D63;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="140" height="80" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b style=&quot;font-size:16px;color:#5F7D63;&quot;&gt;結果を確認&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;成果物を自分の目で開く&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;minutes.md&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;丸投げにしないための一手間&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#EAF0EA;strokeColor=#5F7D63;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="760" width="980" height="80" as="geometry" /></mxCell><mxCell id="h7" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 7&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#5F7D63;strokeColor=#5F7D63;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="882" width="140" height="80" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b style=&quot;font-size:16px;color:#5F7D63;&quot;&gt;修正を依頼&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;気になった点を伝えるだけ&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;同じファイルがその場で更新&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;ダウンロードし直し不要&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#EAF0EA;strokeColor=#5F7D63;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="882" width="980" height="80" as="geometry" /></mxCell><mxCell id="h8" value="&lt;b style=&quot;color:#FFFFFF;font-size:15px;&quot;&gt;STEP 8&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#5F7D63;strokeColor=#5F7D63;strokeWidth=2;fontColor=#2F3437;align=center;verticalAlign=middle;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="1004" width="140" height="80" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b style=&quot;font-size:16px;color:#5F7D63;&quot;&gt;修正を PLAN.md に反映&lt;/b&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;「PLAN.md にも反映して」&lt;/span&gt;　&lt;span style=&quot;background:#E6E6E6;color:#2F3437;font-family:Menlo,monospace;font-size:12px;padding:1px 6px;border-radius:3px;&quot;&gt;PLAN.md&lt;/span&gt;　&lt;span style=&quot;font-size:13px;color:#5B6168;&quot;&gt;指示書が育つ → 次回に再利用&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#EAF0EA;strokeColor=#5F7D63;strokeWidth=2;fontColor=#2F3437;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="200" y="1004" width="980" height="80" as="geometry" /></mxCell><mxCell id="flow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#3A3F44;fontSize=13;fontColor=#2F3437;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#3A3F44;fontSize=13;fontColor=#2F3437;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#3A3F44;fontSize=13;fontColor=#2F3437;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#3A3F44;fontSize=13;fontColor=#2F3437;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#3A3F44;fontSize=13;fontColor=#2F3437;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#3A3F44;fontSize=13;fontColor=#2F3437;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2.5;strokeColor=#3A3F44;fontSize=13;fontColor=#2F3437;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jr7" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1215" y="917" width="10" height="10" as="geometry" /></mxCell><mxCell id="jr6" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1215" y="795" width="10" height="10" as="geometry" /></mxCell><mxCell id="rp1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC5B38;strokeWidth=2.5;dashed=1;endArrow=none;endFill=0;startArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b7" target="jr7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rp2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC5B38;strokeWidth=2.5;dashed=1;endArrow=none;endFill=0;startArrow=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontFamily=Hiragino Sans;" edge="1" parent="1" source="jr7" target="jr6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rp3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC5B38;strokeWidth=2.5;dashed=1;endArrow=block;endFill=1;startArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontFamily=Hiragino Sans;" edge="1" parent="1" source="jr6" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="jf8" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1255" y="1039" width="10" height="10" as="geometry" /></mxCell><mxCell id="jf3" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1255" y="429" width="10" height="10" as="geometry" /></mxCell><mxCell id="rf1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC5B38;strokeWidth=2.5;dashed=1;endArrow=none;endFill=0;startArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Hiragino Sans;" edge="1" parent="1" source="b8" target="jf8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rf2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC5B38;strokeWidth=2.5;dashed=1;endArrow=none;endFill=0;startArrow=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontFamily=Hiragino Sans;" edge="1" parent="1" source="jf8" target="jf3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rf3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BC5B38;strokeWidth=2.5;dashed=1;endArrow=block;endFill=1;startArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontFamily=Hiragino Sans;" edge="1" parent="1" source="jf3" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lbl_rep" value="&lt;span style=&quot;color:#BC5B38;&quot;&gt;納得できるまで反復&lt;/span&gt;" style="text;html=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontColor=#2F3437;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1236" y="845" width="220" height="32" as="geometry" /></mxCell><mxCell id="lbl_rf" value="&lt;span style=&quot;color:#BC5B38;&quot;&gt;修正を PLAN.md に反映&lt;br&gt;→ 次回はこの指示書から再開&lt;/span&gt;" style="text;html=1;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;fontColor=#2F3437;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="1276" y="654" width="250" height="48" as="geometry" /></mxCell><mxCell id="note0" value="&lt;span style=&quot;color:#2F3437;&quot;&gt;・ 新しい案件 = 新しいフォルダ。案件が混ざらず、本番フォルダを壊す心配もない&lt;/span&gt;" style="text;html=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;fontColor=#2F3437;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="1130" width="1300" height="28" as="geometry" /></mxCell><mxCell id="note1" value="&lt;span style=&quot;color:#2F3437;&quot;&gt;・ PLAN.md（指示書）に詳細を書くので、指示は「PLAN.md に従って実行して」の 1 行で済む&lt;/span&gt;" style="text;html=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;fontColor=#2F3437;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="1162" width="1300" height="28" as="geometry" /></mxCell><mxCell id="note2" value="&lt;span style=&quot;color:#2F3437;&quot;&gt;・ STEP6 と STEP7 の往復が、「AI に任せる」と「AI に丸投げする」の分かれ目になる&lt;/span&gt;" style="text;html=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;fontColor=#2F3437;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="1194" width="1300" height="28" as="geometry" /></mxCell><mxCell id="note3" value="&lt;span style=&quot;color:#2F3437;&quot;&gt;・ 最後に修正内容を PLAN.md へ反映すると、指示書が資産として育ち、次回はそれを渡すだけで再現できる&lt;/span&gt;" style="text;html=1;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;fontColor=#2F3437;fontFamily=Hiragino Sans;" vertex="1" parent="1"><mxGeometry x="60" y="1226" width="1300" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
